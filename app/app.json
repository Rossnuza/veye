{
  "expo": {
    "name": "Veye",
    "slug": "veye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#1B8A5E",
    "backgroundColor": "#FBF7EF",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Veye uses the camera to scan the code on the back of your child's tracker.",
        "NSLocationWhenInUseUsageDescription": "Veye uses your location to give you directions to your child."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B8A5E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Veye uses the camera to scan the code on the back of your child's tracker."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Veye uses your location to give you directions to your child."
        }
      ]
    ],
    "extra": {
      "apiUrl": ""
    }
  }
}
